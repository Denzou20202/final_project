# App
NODE_ENV=development

# Порты сервисов (локальная разработка — каждый сервис может работать автономно).
# Намеренно пропущены 3000/3001 — они зарезервированы/заняты чем-то другим на
# основной машине разработчика этого проекта.
API_GATEWAY_PORT=3010
TICKET_SERVICE_PORT=3011
USER_SERVICE_PORT=3002
NOTIFICATION_SERVICE_PORT=3003
CHAT_SERVICE_PORT=3004
ANALYTICS_SERVICE_PORT=3005
KNOWLEDGE_SERVICE_PORT=3006

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=veloxdesk
DB_USER=veloxdesk
DB_PASSWORD=secret
# Лимит пула для каждого сервиса — держите (это значение * количество запущенных сервисов) 
# значительно ниже максимального числа подключений Postgres (max_connections, по умолчанию 100).
DB_POOL_MAX=10

# CORS — разделенный запятыми список разрешенных доменов в браузере
CORS_ORIGINS=http://localhost:4200,http://localhost:4201

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Signs short-lived 2FA challenge tokens (auth.service.ts) and OIDC login
# state tokens (oidc-auth.controller.ts).
JWT_TWO_FACTOR_SECRET=change-me-two-factor-secret
JWT_OIDC_STATE_SECRET=change-me-oidc-state-secret

# Symmetric encryption keys (not signing secrets) — encrypt stored TOTP
# secrets (totp-encryption.service.ts) and LDAP/OIDC directory credentials
# (directory-secret-encryption.service.ts) at rest. Must be a base64-encoded
# 32-byte key (openssl rand -base64 32) — these dev values are fine to share
# since this is a local-only dev instance, never reuse them in production.
TOTP_ENCRYPTION_KEY=jzq9UTidyhWtLuL74fT219KIQDv99K9eT99t3gfdZp0=
DIRECTORY_SECRET_ENCRYPTION_KEY=+GPQXGj0YtZFLPjKXl0kMHY7NHAUzERUovE5qrI8t0s=

# Email (SMTP) — локальная разработка через Greenmail (см. docker-compose.yml), без TLS.
# Для AUTH-входа в Greenmail используется только локальная часть ("support"), а не полный
# адрес — реальные провайдеры обычно требуют полный email; скорректируйте при деплое.
# При деплое также укажите реального провайдера и установите SMTP_SECURE=true (порт 465/587).
SMTP_HOST=localhost
SMTP_PORT=3025
SMTP_SECURE=false
SMTP_USER=support
SMTP_PASS=greenmail-secret

# Email (IMAP) — тот же инстанс Greenmail, локально без TLS, такая же особенность
# со входом только по локальной части, как и у SMTP_USER выше.
IMAP_HOST=localhost
IMAP_PORT=3143
IMAP_SECURE=false
IMAP_USER=support
IMAP_PASS=greenmail-secret
# Как часто ticket-service опрашивает почтовый ящик на наличие новых сообщений (в мс).
IMAP_POLL_INTERVAL_MS=15000
# Полный адрес почтового ящика, используется для заголовков "От" (From) и т.д.
SUPPORT_EMAIL_ADDRESS=support@veloxdesk.local

# Telegram-бот (канал поддержки) — получите токен у @BotFather, затем
# зарегистрируйте вебхук (см. блок /api/telegram в infra/nginx/nginx.prod.conf
# и модуль telegram-ingestion). Оставьте TELEGRAM_BOT_TOKEN пустым, чтобы
# отключить только исходящую отправку — входящий вебхук все равно будет создавать/обновлять
# тикеты, просто бот не сможет отвечать обратно в чат.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=dev-telegram-webhook-secret
# Публичный @handle (без @, не секрет) — используется сервисом user-service для создания
# диплинка "Подключить Telegram" в клиентском портале (t.me/<username>?start=...).
TELEGRAM_BOT_USERNAME=veloxdesk_support_bot

# Cloudflare Turnstile (CAPTCHA) — verifies registration always, and login
# once LoginLockoutService flags the caller's IP (see auth.service.ts).
# This is Cloudflare's own published "always passes" test secret — safe to
# commit, works with any response token from the matching test site key
# (see frontend/client-portal/.env.example's VITE_TURNSTILE_SITE_KEY).
# Real prod keys come from https://dash.cloudflare.com/?to=/:account/turnstile
# and never go in this file — see .env.production.example instead.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Бесплатный API-ключ DeepL (translate.controller.ts) — обеспечивает автоперевод RU->UK/EN
# для автозаполнения форм в 8 справочниках администратора (статусы тикетов, кастомные
# поля, макросы, статьи, отделы, теги, категории, статусы сотрудников).
# Оставьте пустым для отключения — эндпоинт просто вернет null для обоих языков,
# и администраторы будут вписывать uk/en поля вручную. Получить бесплатный ключ 
# (500k символов/мес, без привязки карты) можно на https://www.deepl.com/pro-api.
DEEPL_API_KEY=

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# S3 (локальная разработка через MinIO, см. docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=veloxdesk-attachments
S3_REGION=us-east-1
# MinIO root creds — bootstrap the dev minio container only.
S3_ACCESS_KEY=veloxdesk
S3_SECRET_KEY=veloxdesk-secret
# App-facing creds ticket-service/knowledge-service actually read. In prod
# this MUST be a separate, least-privilege MinIO user (see
# infra/minio-provision-app-user.sh) — reusing the root creds here is only
# acceptable in dev, where there's no real security boundary to protect.
S3_APP_ACCESS_KEY=veloxdesk
S3_APP_SECRET_KEY=veloxdesk-secret

# Sentry
SENTRY_DSN=
