# Template for .env.production — copy to .env.production and fill in real
# values. .env.production itself should never be committed if this repo
# ever gets a git remote; this template is safe to commit.

# Required by docker-compose.prod.yml's x-prod-env-guard — deliberately never
# set in the dev-repo .env, so raw `docker compose -f docker-compose.prod.yml
# ...` (bypassing infra/prod-compose.sh) fails outright instead of silently
# substituting dev secrets. Don't add this to .env/.env.example.
NODE_ENV=production
VELOXDESK_PROD_ENV_GUARD=1

DB_HOST=postgres
DB_PORT=5432
DB_NAME=veloxdesk
DB_USER=veloxdesk
DB_PASSWORD=
DB_POOL_MAX=10

REDIS_HOST=redis
REDIS_PORT=6379

ELASTICSEARCH_NODE=http://elasticsearch:9200

S3_ENDPOINT=http://minio:9000
S3_BUCKET=veloxdesk-attachments
# MinIO ROOT/admin credentials — used ONLY to bootstrap the minio container
# itself (see the minio: service block in docker-compose.prod.yml).
# Application code (ticket-service/knowledge-service) must NEVER read these
# directly — use S3_APP_ACCESS_KEY/S3_APP_SECRET_KEY below instead.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# App-facing, least-privilege MinIO credentials — read by ticket-service's
# and knowledge-service's S3Service (only s3:GetObject/PutObject/
# DeleteObject/ListBucket on the one bucket above, not admin access).
# Generate two real secrets, put them here, THEN provision the MinIO user
# and policy with infra/minio-provision-app-user.sh — see that script's own
# header comment for the full rollout order. Never set these equal to the
# root credentials above except as a temporary rollback mitigation.
S3_APP_ACCESS_KEY=
S3_APP_SECRET_KEY=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Same generation method as above. Signs short-lived 2FA challenge tokens
# (auth.service.ts) and OIDC login state tokens (oidc-auth.controller.ts).
JWT_TWO_FACTOR_SECRET=
JWT_OIDC_STATE_SECRET=

# Symmetric encryption keys (not signing secrets) — encrypt stored TOTP
# secrets (totp-encryption.service.ts) and LDAP/OIDC directory credentials
# (directory-secret-encryption.service.ts) at rest.
# Generate with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
DIRECTORY_SECRET_ENCRYPTION_KEY=

# Real mailbox — greenmail (dev fake server) doesn't apply in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_POLL_INTERVAL_MS=15000
SUPPORT_EMAIL_ADDRESS=

# This machine's actual public IP/domain, e.g. https://203.0.113.10
CORS_ORIGINS=

SENTRY_DSN=

# Telegram bot integration — lets clients open/reply to tickets via
# Telegram (telegram.controller.ts; webhook route is the /api/telegram
# block in infra/nginx/nginx.prod.conf). Leave all three blank to disable.
# Get a token from @BotFather, then register the webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# DeepL free-tier API key — powers the RU->UK/EN auto-translate form-fill on
# the 8 admin catalogs. Leave blank to disable (admins type uk/en by hand).
# Get a free key (500k chars/month, no card) at https://www.deepl.com/pro-api.
DEEPL_API_KEY=

# Cloudflare Turnstile (CAPTCHA) — verifies registration always, and login
# once LoginLockoutService flags the caller's IP (see auth.service.ts).
# The SECRET key only, server-side — the public Site Key goes in
# frontend/client-portal/.env.production's VITE_TURNSTILE_SITE_KEY instead.
# Create a free widget (2 min, no card) at
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=

# Grafana admin login (bound to 127.0.0.1 only, reach via SSH tunnel)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
